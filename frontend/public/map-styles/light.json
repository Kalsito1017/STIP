{
  "version": 8,
  "name": "STIP Light",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4f0" }
    },
    {
      "id": "earth",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "type": "fill",
      "filter": ["match", ["get","class"], ["wood","grass","ice","sand","wetland"], true, false],
      "paint": { "fill-color": "#e8e4df" }
    },
    {
      "id": "earth_landuse",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill",
      "filter": ["match", ["get","class"], ["residential","commercial","industrial"], true, false],
      "paint": { "fill-color": "#e8e4df" }
    },
    {
      "id": "water",
      "source": "openmaptiles",
      "source-layer": "water",
      "type": "fill",
      "paint": { "fill-color": "#a0c8e8" }
    },
    {
      "id": "waterway",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "type": "line",
      "paint": { "line-color": "#a0c8e8", "line-width": 1 }
    },
    {
      "id": "landuse_park",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill",
      "filter": ["==", ["get","class"], "cemetery"],
      "paint": { "fill-color": "#d6d0c4" }
    },
    {
      "id": "landuse_hospital",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill",
      "filter": ["==", ["get","class"], "hospital"],
      "paint": { "fill-color": "#f0d0d0" }
    },
    {
      "id": "landuse_school",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill",
      "filter": ["==", ["get","class"], "school"],
      "paint": { "fill-color": "#d0e8f0" }
    },
    {
      "id": "landuse_pitch",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill",
      "filter": ["match", ["get","class"], ["pitch","track"], true, false],
      "paint": { "fill-color": "#c8e6c0" }
    },
    {
      "id": "park",
      "source": "openmaptiles",
      "source-layer": "park",
      "type": "fill",
      "paint": { "fill-color": "#c8e6c0", "fill-opacity": 0.7 }
    },
    {
      "id": "roads-minor",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "type": "line",
      "filter": ["match", ["get","class"], ["minor","service","track"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential",1.2], ["zoom"], 13, 0, 14, 2.5, 20, 18]
      }
    },
    {
      "id": "roads-secondary",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "type": "line",
      "filter": ["match", ["get","class"], ["secondary","tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential",1.2], ["zoom"], 8, 1.5, 20, 17]
      }
    },
    {
      "id": "roads-primary",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "type": "line",
      "filter": ["match", ["get","class"], ["primary","trunk"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0d080",
        "line-width": ["interpolate", ["exponential",1.2], ["zoom"], 5, 0.4, 6, 0.7, 7, 1.75, 20, 22]
      }
    },
    {
      "id": "roads-highway",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "type": "line",
      "filter": ["all", ["==", ["get","class"], "motorway"], ["!=", ["get","ramp"], 1]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f0a040",
        "line-width": ["interpolate", ["exponential",1.2], ["zoom"], 5, 0.4, 6, 0.7, 7, 1.75, 20, 22]
      }
    },
    {
      "id": "roads-rail",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "type": "line",
      "filter": ["==", ["get","class"], "rail"],
      "paint": {
        "line-color": "#bbb",
        "line-width": ["interpolate", ["exponential",1.4], ["zoom"], 14, 0.4, 15, 0.75, 20, 2]
      }
    },
    {
      "id": "buildings",
      "source": "openmaptiles",
      "source-layer": "building",
      "type": "fill",
      "minzoom": 13,
      "paint": { "fill-color": "#ddd8d4", "fill-opacity": 0.6 }
    },
    {
      "id": "pois",
      "source": "openmaptiles",
      "source-layer": "poi",
      "type": "symbol",
      "minzoom": 15,
      "layout": {
        "text-field": ["coalesce", ["get","name_en"], ["get","name"]],
        "text-font": ["Open Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#666",
        "text-halo-color": "#fff",
        "text-halo-width": 1
      }
    },
    {
      "id": "places",
      "source": "openmaptiles",
      "source-layer": "place",
      "type": "symbol",
      "minzoom": 8,
      "filter": ["match", ["get","class"], ["city","town","village","neighborhood","suburb","quarter"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get","name_en"], ["get","name"]],
        "text-font": ["Open Sans Bold"],
        "text-size": ["step", ["get","rank"], 12, 2, 10, 3, 8]
      },
      "paint": {
        "text-color": "#333",
        "text-halo-color": "#fff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "roads-labels",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "type": "symbol",
      "minzoom": 12,
      "filter": ["match", ["get","class"], ["primary","secondary","tertiary","trunk"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get","name_en"], ["get","name"]],
        "text-font": ["Open Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#666",
        "text-halo-color": "#fff",
        "text-halo-width": 1
      }
    },
    {
      "id": "boundaries",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "type": "line",
      "filter": ["all", [">=", ["get","admin_level"], 2], ["<=", ["get","admin_level"], 4]],
      "paint": {
        "line-color": "#9e9cab",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1, 12, 3],
        "line-dasharray": [3, 2]
      }
    }
  ]
}
