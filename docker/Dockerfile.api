FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/SofiaTransport.Domain/SofiaTransport.Domain.csproj SofiaTransport.Domain/
COPY src/SofiaTransport.Application/SofiaTransport.Application.csproj SofiaTransport.Application/
COPY src/SofiaTransport.Infrastructure/SofiaTransport.Infrastructure.csproj SofiaTransport.Infrastructure/
COPY src/SofiaTransport.Api/SofiaTransport.Api.csproj SofiaTransport.Api/
RUN dotnet restore SofiaTransport.Api/SofiaTransport.Api.csproj

COPY src/ .
RUN dotnet publish SofiaTransport.Api/SofiaTransport.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app .
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 5000
ENTRYPOINT ["dotnet", "SofiaTransport.Api.dll"]
