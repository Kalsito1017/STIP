# ──────────────────────────────────────────────────
# Sofia Transport Intelligence Platform — ENV Template
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ──────────────────────────────────────────────────

# ── Mandatory ──────────────────────────────────────

# Database password (required, no default)
DB_PASSWORD=your_strong_password_here

# Sofia GTFS static data (routes, stops, schedules)
GTFS_STATIC_URL=https://your-gtfs-static-url-here

# Sofia GTFS realtime vehicle positions protobuf feed
GTFS_RT_FEED_URL=https://your-gtfs-rt-url-here

# PostgreSQL connection string (Docker Compose sets hostname "postgres")
DB_CONNECTION_STRING=Host=postgres;Database=sofia_transport;Username=stip_app;Password=your_password_here

# Redis connection (Docker Compose sets hostname "redis")
REDIS_CONNECTION=redis:6379

# Python ML service URL (internal Docker network)
ML_SERVICE_URL=http://ml:8000

# GTFS polling interval in seconds
POLL_INTERVAL_SECONDS=15

# Shared secret for ML internal retrain endpoint (protects against unauthorized retraining)
ML_INTERNAL_SECRET=change-me-to-a-random-secret

# ── Optional real-time feeds ────────────────────────

# Sofia GTFS realtime trip updates protobuf feed (leave empty to disable)
GTFS_RT_TRIP_UPDATES_URL=https://your-gtfs-rt-trip-updates-url-here

# Sofia GTFS realtime alerts protobuf feed (leave empty to disable)
GTFS_RT_ALERTS_URL=https://your-gtfs-rt-alerts-url-here

# ── Optional ───────────────────────────────────────

# Weather API for ML feature "weather_score" (OpenWeatherMap / WeatherAPI.com)
WEATHER_API_KEY=

# Mapbox public access token (required for Mapbox GL JS frontend map)
MAPBOX_TOKEN=

# JWT signing key — only needed if admin auth UI is built
JWT_SECRET_KEY=

# ── Development tools ─────────────────────────────

# PgAdmin — database management GUI (http://localhost:5050)
PGADMIN_EMAIL=admin@stip.local
PGADMIN_PASSWORD=choose-a-strong-password

# Docker Compose profile: "management" enables pgAdmin in dev
# Remove from production — use docker compose --profile management up pgadmin instead
COMPOSE_PROFILES=management
